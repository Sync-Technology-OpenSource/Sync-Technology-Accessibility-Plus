{
  "manifest_version": 3,
  "name": "Sync Technology Accessibility Plus",
  "version": "1.3",
  "description": "Module d'accessibilité web avancé",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["accessibility.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Y"
      }
    },
    "read-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+R"
      },
      "description": "Lire/Arrêter la lecture audio de la page"
    },
    "toggle-contrast": {
      "suggested_key": {
        "default": "Ctrl+Shift+C"
      },
      "description": "Activer/Désactiver le mode contraste"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "accessibility-plus@sync-technology.fr"
    }
  }
}