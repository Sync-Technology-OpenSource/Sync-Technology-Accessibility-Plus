{
  "manifest_version": 3,
  "name": "Sync Technology Accessibility Plus",
  "version": "1.1",
  "description": "Module d'accessibilité web avancé",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["accessibility.css"]
    }
  ]
}